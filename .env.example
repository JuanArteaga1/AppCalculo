# Variables de entorno para LimitsHub
# Copia este archivo a .env y rellena tus claves

# =============================================================================
# TUTOR CON IA
# =============================================================================
# El tutor se llama solo desde el backend (POST /api/tutor) y su clave va en
# backend/.env (GEMINI_API_KEY). Aqui no va ninguna clave de IA: todo lo que lleva
# prefijo VITE_ queda a la vista en el navegador (spec-gestion-ia CA-09).

# Muestra los espacios de estudiante y maestro sin sesion, para revisar las maquetas.
# Dejarlo en false en produccion.
VITE_DEMO_ESPACIOS=false


PORT=5100

USER_DB=tu_usuario_de_mongodb
PASS_DB=tu_contraseña_de_mongodb
SERVER_DB=tu_cluster.mongodb.net

# Administrador inicial (scripts/crearAdmin.js)
ADMIN_NOMBRE=
ADMIN_CORREO=
ADMIN_PASSWORD=

# Sesion: una cadena aleatoria de al menos 32 caracteres
JWT_SECRET=

# Origenes que pueden llamar a la API, separados por comas
ORIGENES_PERMITIDOS=http://localhost:5173

# true cuando el backend este detras del proxy de Vercel
CONFIAR_PROXY=false

# Carpeta donde se guardan las imagenes de los temas
CARPETA_ARCHIVOS=uploads

# false apaga el registro de peticiones y de operaciones de MongoDB en la consola
LOG_PETICIONES=true

# Clave de OpenAI en el servidor (EG-052). No uses VITE_OPENAI_API_KEY en producción.
OPENAI_API_KEY=


PORT=5100

USER_DB=tu_usuario_de_mongodb
PASS_DB=tu_contraseña_de_mongodb
SERVER_DB=tu_cluster.mongodb.net
# Alternativa para un MongoDB local (sin Atlas): tiene prioridad sobre las tres anteriores.
# MONGO_URI=mongodb://127.0.0.1:27017/PlataformaEducativa

# Administrador inicial (scripts/crearAdmin.js)
ADMIN_NOMBRE=
ADMIN_CORREO=
ADMIN_PASSWORD=

# Sesion: una cadena aleatoria de al menos 32 caracteres
JWT_SECRET=

# Origenes que pueden llamar a la API, separados por comas
ORIGENES_PERMITIDOS=http://localhost:5173

# true cuando el backend este detras del proxy de Vercel
CONFIAR_PROXY=false

# Carpeta donde se guardan las imagenes de los temas
CARPETA_ARCHIVOS=uploads

# Correo saliente (SMTP). Si falta alguno, el backend devuelve el enlace para copiar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_REMITENTE=EDUCALC XE <no-responder@uniautonoma.edu.co>

# URL pública de la app, sin barra final. Se usa para armar enlaces de invitación, confirmación y restablecimiento.
URL_APP=http://localhost:5173

# Login con Google (Google Cloud > APIs y servicios > Credenciales).
# La URI de redirección debe ser URL_APP + /api/usuarios/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: si el proxy usa otro dominio, escríbela completa.
GOOGLE_REDIRECT_URI=

# Roles del login con Google. El dominio siempre debe ser @uniautonoma.edu.co.
# Las cuentas existentes conservan su rol; estos correos se ascienden si hace falta.
ADMIN_CORREOS=estiven.realpe.h@uniautonoma.edu.co
DOCENTE_CORREOS=juan.arteaga.f@uniautonoma.edu.co

# Atajos del login: abren sesión con las cuentas prueba.* de crearUsuariosPrueba.
# Solo para desarrollo; en producción la ruta responde 404 aunque esté en true.
DEMO_ACCESO=false

# false apaga el registro de peticiones y de operaciones de MongoDB en la consola
LOG_PETICIONES=true

# Clave de OpenAI en el servidor (EG-052). No uses VITE_OPENAI_API_KEY en producción.
OPENAI_API_KEY=
